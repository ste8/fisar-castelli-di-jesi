{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "palette": [
        { "slug": "oro-fisar", "name": "Oro FISAR", "color": "#b9aa54" },
        { "slug": "crimson", "name": "Crimson", "color": "#b33c61" },
        { "slug": "bordeaux", "name": "Bordeaux", "color": "#641629" },
        { "slug": "dark-gray-purple", "name": "Dark Gray Purple", "color": "#282332" },
        { "slug": "bianco", "name": "Bianco", "color": "#ffffff" }
      ]
    },
    "layout": {
      "contentSize": "736px",
      "wideSize": "1216px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
          "name": "Cormorant Garamond",
          "slug": "fisar-heading"
        },
        {
          "fontFamily": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "Poppins",
          "slug": "fisar-body"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#282332"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--fisar-body)",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fisar-heading)",
          "fontWeight": "600",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": { "text": "#641629" }
      }
    }
  }
}
